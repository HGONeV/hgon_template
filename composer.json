{
    "name": "hgon/hgon-template",
    "type": "typo3-cms-extension",
    "description": "HGON base extension for templates and extension overrides",
    "authors": [
        {
            "name": "Maximilian Fäßler",
            "role": "Developer"
        }
    ],
    "require": {
        "derhansen/sf_event_mgt": "^8.1",
        "dreistromland/typo3-hcaptcha": "^2.3",
        "hgon/hgon-donation": "dev-master",
        "mediadreams/md_news_author": "^9.0",
        "typo3/cms-core": "^9.5 || ^10.4 || ^11.5 || ^12.4 || ^13.4"
    },
    "autoload": {
        "psr-4": {
            "HGON\\HgonTemplate\\": "Classes/"
        }
    },
    "replace": {
        "hgon_template": "self.version",
        "typo3-ter/hgon-template": "self.version"
    },
	"extra": {
		"typo3/cms": {
			"extension-key": "hgon_template"
		}
	}
}
